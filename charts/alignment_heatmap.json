
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Heroes, Villains and Everything Between",
    "subtitle": "Share of recorded character alignments by decade",
    "anchor": "start",
    "fontSize": 18
  },
  "width": "container",
  "height": 220,
  "data": {
    "url": "data/alignment_by_decade.json"
  },
  "params": [
    {
      "name": "publisherChoice",
      "value": "Marvel",
      "bind": {
        "input": "select",
        "options": ["Marvel", "DC"],
        "name": "Publisher: "
      }
    }
  ],
  
  "transform": [
    {
      "filter": "datum.publisher === publisherChoice"
    },
    {
      "impute": "characters",
      "key": "alignment",
      "groupby": ["publisher", "decade"],
      "keyvals": [
        "Good",
        "Bad",
        "Neutral",
        "Unknown"
      ],
      "method": "value",
      "value": 0
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "characters",
          "as": "decade_total"
        }
      ],
      "groupby": ["publisher", "decade"]
    },
    {
      "calculate": "datum.decade_total > 0 ? datum.characters / datum.decade_total : null",
      "as": "share"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "#CBD5E1",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "decade",
      "type": "ordinal",
      "sort": "ascending",
      "title": "First Appearance Decade"
    },
    "y": {
      "field": "alignment",
      "type": "nominal",
      "title": "Character Alignment",
      "sort": [
        "Good",
        "Bad",
        "Neutral",
        "Unknown"
      ]
    },
    
    "color": {
      "field": "share",
      "type": "quantitative",
      "title": "Share Within Decade",
      "scale": {
        "domain": [0, 1],
        "range": [
          "#E8F3FB",
          "#084594"
        ]
      },
      "legend": {
        "format": ".0%",
        "gradientLength": 180
      }
    },
    
    "tooltip": [
      {
        "field": "publisher",
        "title": "Publisher"
      },
      {
        "field": "decade",
        "title": "First Appearance Decade"
      },
      {
        "field": "alignment",
        "title": "Alignment"
      },
      {
        "field": "characters",
        "type": "quantitative",
        "title": "Character Entries"
      },
      {
        "field": "decade_total",
        "type": "quantitative",
        "title": "Total Entries in Decade"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Share of Decade",
        "format": ".1%"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
