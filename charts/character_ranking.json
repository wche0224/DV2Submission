{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Comic Characters with the Most Appearances",
    "subtitle": "Top 15 recorded characters per publisher · historical dataset",
    "anchor": "start",
    "fontSize": 17,
    "font": "Georgia",
    "color": "#182942",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#64748B"
  },
  "width": "container",
  "height": {
    "step": 28
  },
  "data": {
    "url": "data/top_characters.json"
  },
  "params": [
    {
      "name": "rankingPublisher",
      "value": "Marvel",
      "bind": {
        "input": "select",
        "options": [
          "Marvel",
          "DC"
        ],
        "name": "Publisher: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.publisher === rankingPublisher"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "appearances",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 15"
    }
  ],
  "encoding": {
    "y": {
      "field": "name",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "appearances",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "labelLimit": 225,
        "labelFontSize": 12,
        "labelPadding": 8,
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "appearances",
      "type": "quantitative",
      "title": "Recorded Comic Appearances",
      "scale": {
        "zero": true
      },
      "axis": {
        "format": ",d",
        "tickCount": 6,
        "labelOverlap": true,
        "grid": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#CCCCCC"
      },
      "encoding": {
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "stroke": "#263238",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "publisher",
          "type": "nominal",
          "scale": {
            "domain": [
              "Marvel",
              "DC"
            ],
            "range": [
              "#D55E00",
              "#0072B2"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Character"
          },
          {
            "field": "publisher",
            "title": "Publisher"
          },
          {
            "field": "appearances",
            "title": "Appearances",
            "format": ",d"
          },
          {
            "field": "rank",
            "title": "Rank"
          }
        ],
        "size": {
          "condition": {
            "test": "datum.rank === 1",
            "value": 260
          },
          "value": 110
        },
        "opacity": {
          "condition": {
            "test": "datum.rank === 1",
            "value": 1
          },
          "value": 0.75
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#E7EAF0",
      "domainColor": "#BCC5D0",
      "tickColor": "#BCC5D0"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#334155",
      "titleColor": "#334155",
      "symbolSize": 115
    },
    "title": {
      "font": "Georgia",
      "fontSize": 17,
      "fontWeight": "bold",
      "color": "#182942",
      "subtitleFont": "Arial",
      "subtitleFontSize": 12,
      "subtitleColor": "#65748A",
      "anchor": "start"
    }
  },
  "padding": {
    "top": 6,
    "right": 12,
    "bottom": 7,
    "left": 4
  }
}
