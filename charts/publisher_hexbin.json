{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Does Comic Publishing Cluster?",
    "subtitle": "Density of recorded publisher headquarters",
    "anchor": "start",
    "fontSize": 17,
    "font": "Georgia",
    "color": "#182942",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#64748B"
  },
  "width": "container",
  "height": 400,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@3/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E5E7EB",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/publisher_hexbins.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.publishers",
          "as": "publisher_count"
        },
        {
          "calculate": "datum.properties.locations",
          "as": "location_count"
        },
        {
          "calculate": "datum.properties.example_cities",
          "as": "example_cities"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "publisher_count",
          "type": "quantitative",
          "title": "Publisher Associations",
          "scale": {
            "scheme": "purples",
            "domainMin": 0
          },
          "legend": {
            "title": "Publisher Associations",
            "orient": "right",
            "gradientLength": 180,
            "labelFontSize": 12,
            "titleFontSize": 13
          }
        },
        "tooltip": [
          {
            "field": "publisher_count",
            "type": "quantitative",
            "title": "Publisher Associations"
          },
          {
            "field": "location_count",
            "type": "quantitative",
            "title": "Headquarters Locations"
          },
          {
            "field": "example_cities",
            "type": "nominal",
            "title": "Example Locations"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#E7EAF0",
      "domainColor": "#BCC5D0",
      "tickColor": "#BCC5D0"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#334155",
      "titleColor": "#334155",
      "symbolSize": 115
    },
    "title": {
      "font": "Georgia",
      "fontSize": 17,
      "fontWeight": "bold",
      "color": "#182942",
      "subtitleFont": "Arial",
      "subtitleFontSize": 12,
      "subtitleColor": "#65748A",
      "anchor": "start"
    }
  },
  "padding": {
    "top": 6,
    "right": 12,
    "bottom": 7,
    "left": 4
  }
}
