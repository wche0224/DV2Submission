{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Are Comic Publishers Headquartered?",
    "subtitle": "Recorded publisher headquarters locations in Wikidata",
    "anchor": "start",
    "fontSize": 17,
    "font": "Georgia",
    "color": "#182942",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#64748B"
  },
  "width": "container",
  "height": 400,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@3/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E8EDF2",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/publisher_locations.json"
      },
      "transform": [
        {
          "filter": "isValid(datum.longitude) && isValid(datum.latitude) && datum.publishers > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#6A3D9A",
        "opacity": 0.55,
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "publishers",
          "type": "quantitative",
          "title": "Publisher Records",
          "scale": {
            "type": "linear",
            "zero": true,
            "range": [
              0,
              1200
            ]
          },
          "legend": {
            "title": "Publishers per Location",
            "orient": "right"
          }
        },
        "order": {
          "field": "publishers",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "city",
            "type": "nominal",
            "title": "Headquarters Location"
          },
          {
            "field": "publishers",
            "type": "quantitative",
            "title": "Publisher Records"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#E7EAF0",
      "domainColor": "#BCC5D0",
      "tickColor": "#BCC5D0"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#334155",
      "titleColor": "#334155",
      "symbolSize": 115
    },
    "title": {
      "font": "Georgia",
      "fontSize": 17,
      "fontWeight": "bold",
      "color": "#182942",
      "subtitleFont": "Arial",
      "subtitleFontSize": 12,
      "subtitleColor": "#65748A",
      "anchor": "start"
    }
  },
  "padding": {
    "top": 6,
    "right": 12,
    "bottom": 7,
    "left": 4
  }
}
