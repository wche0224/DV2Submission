{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Rise of Heroes and Villains",
    "subtitle": "Character debuts by alignment, 1930–2014",
    "anchor": "start",
    "fontSize": 17,
    "font": "Georgia",
    "color": "#182942",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#64748B"
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/alignment_by_decade.json"
  },
  "params": [
    {
      "name": "streamPublisher",
      "value": "Marvel",
      "bind": {
        "input": "select",
        "options": [
          "Marvel",
          "DC"
        ],
        "name": "Publisher: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.publisher === streamPublisher"
    },
    {
      "filter": "indexof(['Good', 'Bad', 'Neutral'], datum.alignment) >= 0"
    }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "opacity": 0.9
  },
  "encoding": {
    "x": {
      "field": "decade",
      "type": "ordinal",
      "sort": "ascending",
      "title": "First Appearance Decade",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "characters",
      "aggregate": "sum",
      "type": "quantitative",
      "stack": "center",
      "axis": null
    },
    "color": {
      "field": "alignment",
      "type": "nominal",
      "title": "Character Alignment",
      "scale": {
        "domain": [
          "Good",
          "Bad",
          "Neutral"
        ],
        "range": [
          "#009E73",
          "#CC79A7",
          "#6B7280"
        ]
      },
      "legend": {
        "orient": "top",
        "title": null
      }
    },
    "tooltip": [
      {
        "field": "decade",
        "title": "Decade"
      },
      {
        "field": "alignment",
        "title": "Alignment"
      },
      {
        "aggregate": "sum",
        "field": "characters",
        "type": "quantitative",
        "title": "Character Debuts"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#334155",
      "titleColor": "#334155",
      "gridColor": "#E7EAF0",
      "domainColor": "#BCC5D0",
      "tickColor": "#BCC5D0"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#334155",
      "titleColor": "#334155",
      "symbolSize": 115
    },
    "title": {
      "font": "Georgia",
      "fontSize": 17,
      "fontWeight": "bold",
      "color": "#182942",
      "subtitleFont": "Arial",
      "subtitleFontSize": 12,
      "subtitleColor": "#65748A",
      "anchor": "start"
    }
  },
  "padding": {
    "top": 6,
    "right": 12,
    "bottom": 7,
    "left": 4
  }
}
