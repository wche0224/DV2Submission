
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Who Gets the Most Appearances?",
    "subtitle": "Distribution of recorded appearances by alignment and publisher",
    "anchor": "start",
    "fontSize": 18
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/appearance_records.json"
  },
  "transform": [
    {
      "filter": "indexof(['Good', 'Bad', 'Neutral'], datum.alignment) >= 0"
    }
  ],
  "mark": {
    "type": "boxplot",
    "extent": 1.5,
    "outliers": false,
    "size": 28,
    "median": {
      "color": "#1F2937",
      "strokeWidth": 2.5
    },
    "ticks": true
  },
  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "sort": [
        "Marvel · Good",
        "Marvel · Bad",
        "Marvel · Neutral",
        "DC · Good",
        "DC · Bad",
        "DC · Neutral"
      ],
      "axis": {
        "labelFontSize": 13,
        "labelLimit": 200,
        "labelPadding": 10,
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "appearances",
      "type": "quantitative",
      "title": "Recorded Character Appearances (Log Scale)",
      "scale": {
        "type": "log",
        "base": 10
      },
      "axis": {
        "values": [1, 10, 100, 1000, 10000],
        "format": ",d",
        "grid": true,
        "gridColor": "#E5E7EB",
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titlePadding": 14
      }
    },
    "color": {
      "field": "publisher",
      "type": "nominal",
      "title": "Publisher",
      "scale": {
        "domain": ["Marvel", "DC"],
        "range": ["#D55E00", "#0072B2"]
      }
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
